# -----------------------------------
# Application
# -----------------------------------
APP_NAME=bus-tracking-backend
NODE_ENV=development
PORT=5000
API_VERSION=v1

# -----------------------------------
# Database / Cache
# -----------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/bus_tracking
REDIS_URL=redis://localhost:6379

# -----------------------------------
# JWT Secrets
# -----------------------------------
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret-at-least-32-characters

# -----------------------------------
# Token Expiry
# -----------------------------------
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------
# Cookie Settings
# -----------------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# -----------------------------------
# CORS
# -----------------------------------
CORS_ORIGIN=http://localhost:3000

# -----------------------------------
# ETA / Arrival Config
# -----------------------------------
DEFAULT_SPEED_KMH=20
ARRIVAL_RADIUS_METERS=80

# -----------------------------------
# Location Persistence
# -----------------------------------
LOCATION_DB_WRITE_INTERVAL_MS=10000

# -----------------------------------
# Tracking Filter
# -----------------------------------
LOCATION_MIN_INTERVAL_MS=2000
LOCATION_MAX_ACCEPTABLE_ACCURACY_M=120
LOCATION_HARD_REJECT_ACCURACY_M=250
LOCATION_STATIONARY_SPEED_THRESHOLD_KMH=3
LOCATION_MIN_MOVEMENT_DISTANCE_M=4
LOCATION_SIGNIFICANT_MOVEMENT_DISTANCE_M=12
LOCATION_FREEZE_ACCURACY_THRESHOLD_M=35
LOCATION_RELEASE_MOVEMENT_DISTANCE_M=18
LOCATION_CONFIRM_MOVEMENT_DISTANCE_M=28
LOCATION_RAW_SPEED_ASSIST_MIN_KMH=9
LOCATION_MIN_ELAPSED_FOR_MOVEMENT_SECONDS=2.5
LOCATION_HEARTBEAT_INTERVAL_MS=15000
LOCATION_MAX_SERVER_SPEED_KMH=120
LOCATION_ROLLING_WINDOW_MS=180000
LOCATION_ACCELERATION_KMH_PER_SEC=8
LOCATION_DECELERATION_KMH_PER_SEC=12
LOCATION_STRONG_BRAKE_KMH_PER_SEC=20

# -----------------------------------
# Rate Limiting
# -----------------------------------
RL_LOGIN_WINDOW_MS=600000
RL_LOGIN_MAX=20
RL_REFRESH_WINDOW_MS=300000
RL_REFRESH_MAX=120

# -----------------------------------
# Stop Cache
# -----------------------------------
STOPS_CACHE_TTL_MS=300000
STOPS_CACHE_MAX_ENTRIES=200
STOPS_CACHE_TTL_SECONDS=300

# -----------------------------------
# Trip Realtime State
# -----------------------------------
TRIP_STATE_TTL_SECONDS=180

# -----------------------------------
# Trip Lock / Idempotency
# -----------------------------------
TRIP_LOCK_TTL_MS=10000
IDEMPOTENCY_TTL_SECONDS=3600

# -----------------------------------
# Trip stale detection
# -----------------------------------
ENABLE_TRIP_STALE_JOB=true
TRIP_STALE_JOB_INTERVAL_MS=30000
TRIP_STALE_THRESHOLD_SECONDS=60

# -----------------------------------
# One-time real admin bootstrap
# Leave blank unless intentionally running bootstrap:admin
# -----------------------------------
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

GOOGLE_MAPS_SERVER_API_KEY=PASTE_YOUR_NEW_SERVER_KEY_HERE
GOOGLE_ROUTES_TIMEOUT_MS=8000